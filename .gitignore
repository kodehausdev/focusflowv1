#*.iml
#.gradle
#/local.properties
#/.idea/caches
#/.idea/libraries
#/.idea/modules.xml
#/.idea/workspace.xml
#/.idea/navEditor.xml
#/.idea/assetWizardSettings.xml
#.DS_Store
#/build
#/captures
#.externalNativeBuild
#.cxx
#local.properties

gitignore
# IDE files and directories
.idea/
.gradle/
local.properties
*.iml
*.hprof
*.orig
captures/
.DS_Store
build/

# Generated files
*/build/
app/build/
*/release/
*/debug/
*.apk
*.aab
*.ap_
*.dex
*.class

# Local configuration files (sensitive information)
# It's good practice to keep local.properties out, especially if it contains API keys.
# Android Studio usually adds this, but double-check.

# Keystore files (NEVER commit your keystore files)
*.jks
*.keystore

# Log files
*.log

# Caches
.cxx/
.cxxbuild/

# Generated by Android Test
test_results/
*/test-results/
*/androidTest-results/
*/connectedAndroidTest-results/

# User-specific files for some IDEs/tools
.vscode/
.project
.classpath
.settings/

# If using Firebase, it might generate this
# firebase-crashlytics-build_id-*.json

# Specific to your project (if any)
# For example, if you have a local configuration folder you don't want to share:
# my_local_configs/

